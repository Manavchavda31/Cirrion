# Public site URL (used for canonical URLs, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://cirrion.com
# Analytics (all optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
# Lead delivery (optional). Leads are always logged; set a webhook to forward to CRM/Slack/Zapier.
LEAD_WEBHOOK_URL=
# Set to "file" to append leads to .data/leads.jsonl (local/VPS hosting only)
LEAD_STORE=
# Search engine ownership verification (paste only the token, not the whole tag)
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# --- Lead delivery: set at least one of (email, webhook, file). In production the form refuses to say "sent" if none is set.
# Email via Resend (https://resend.com). LEAD_TO_EMAIL can list several addresses, comma-separated.
RESEND_API_KEY=
LEAD_TO_EMAIL=
# Use an address on a domain you have verified in Resend, e.g. "Cirrion <hello@yourdomain.com>"
LEAD_FROM_EMAIL=
# Set to 1 to send the visitor a short "we received your brief" email
LEAD_AUTOREPLY=
# Spam protection (Cloudflare Turnstile, free). Both keys are needed to enable it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Company details shown on the site (all optional; items without a value are hidden)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=
# Set to 1 to preview the placeholder team profiles (never in production)
NEXT_PUBLIC_SHOW_PLACEHOLDER_TEAM=
